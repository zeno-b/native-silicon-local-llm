# ---------------------------------------------------------------------------
# Local LLM — ignore all generated / runtime / secret artifacts.
# Source stays tracked; anything the app writes at runtime does not.
# ---------------------------------------------------------------------------

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Test / type / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/
# Single-file build produced by `python bundle.py` (regenerate, don't commit).
deploy_bundled.py

# ---------------------------------------------------------------------------
# Secrets — never commit. The example file IS tracked (see negation below).
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ---------------------------------------------------------------------------
# Runtime data the app creates under the project root (see core.py paths).
# ---------------------------------------------------------------------------
# Logs (structured JSON logs, model server log, rotations)
logs/
*.log
*.log.*

# SQLite database + WAL/SHM sidecars, exports, SFT sets, partials, benchmarks
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# LoRA adapters and their backups (large, re-trainable)
adapters/
!adapters/.gitkeep

# The sandboxed agent workspace and user uploads
workspace/
uploads/

# Claude-history imports (untrusted uploads, extracted trees, staging)
imports/
data/imports/

# Model / HuggingFace / prompt caches
.cache/
hf_cache/
.huggingface/
prompt_cache/

# Vendored reference material dumped locally (not source)
docs/

# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
